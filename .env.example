# Copy to .env for local development. Never commit the real .env file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=canteen_db_new
PGUSER=postgres
PGPASSWORD=replace_with_your_local_postgres_password
FLASK_SECRET_KEY=replace_with_a_long_random_secret
# For a hosted PostgreSQL service, DATABASE_URL may be used instead.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
